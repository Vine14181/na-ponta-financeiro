# Na Ponta — exemplo de variáveis de ambiente (opcional)
#
# Copie este arquivo para ".env" e preencha se preferir manter a configuração
# do Apps Script fora do data/settings.json. Variáveis definidas aqui têm
# prioridade sobre o settings.json.
#
# As CHAVES DE API (Pierre, Claude, Gemini) NÃO ficam aqui — elas são
# guardadas criptografadas no cofre (data/api_keys.enc), configurável pela
# tela de Configurações do app.

# URL do Apps Script Web App (termina em /exec)
NAPONTA_APPS_SCRIPT_URL=

# Token secreto compartilhado entre o app e o apps_script.gs
NAPONTA_APPS_SCRIPT_TOKEN=
